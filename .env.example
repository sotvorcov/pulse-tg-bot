# ─────────────────────────────────────────────────────────────
#  Pulse — конфигурация. Скопируй в .env и заполни.
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ОБЯЗАТЕЛЬНО: токен бота от @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# Секрет активации владельца. Без него команда /start НЕ сделает тебя
# владельцем (защита от захвата бота чужим). Придумай любую строку.
OWNER_SETUP_SECRET=change-me-to-any-secret

# ── Пути (обычно менять не нужно) ─────────────────────────────
CLAUDE_BIN=/root/.local/bin/claude
DEFAULT_CWD=/root
SESS_DIR=/root/.claude/projects/-root

# Набор инструментов для автопилота claude (acceptEdits + allowlist).
# Bash в списке = разрешены любые команды. Убери лишнее, если нужно строже.
# ALLOWED_TOOLS=Bash Read Edit Write MultiEdit Glob Grep WebFetch WebSearch Task TodoWrite NotebookEdit

# ── ГОЛОС (распознавание речи, всё необязательно) ─────────────
# Достаточно ОДНОГО провайдера. Порядок фолбэка: Deepgram → Яндекс → Gemini → OpenAI → Vertex.

# Deepgram (nova-2, ru) — рекомендуется, стабильный REST
DEEPGRAM_API_KEY=

# Яндекс SpeechKit (RU-нативный) — нужен свежий Api-Key + folderId
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# OpenAI Whisper
OPENAI_API_KEY=

# Google Gemini (по API-ключу)
GEMINI_API_KEY=
GEMINI_ASR_MODEL=gemini-2.5-flash

# Google Vertex (по сервис-аккаунту) — путь к JSON ключа
VERTEX_SA_PATH=/root/.gcp-vertex.json
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
